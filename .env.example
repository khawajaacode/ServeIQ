# Copy to .env.local and fill in real values. See README.md for details.

# Required
MONGODB_URI=mongodb://localhost:27017/serveiq
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Optional (defaults to https://YOUR_SITE_URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional AI providers (enable only the ones you use)
AI_GROQ_KEY=
AI_CEREBRAS_KEY=
AI_GOOGLE_KEY=
AI_SILICONFLOW_KEY=
