{
	"name": "serveiq",
	"author": "khawajaacode",
	"repository": "https://github.com/khawajaacode/ServeIQ.git",
	"homepage": "https://github.com/khawajaacode/ServeIQ",
	"bugs": {
		"url": "https://github.com/khawajaacode/ServeIQ/issues"
	},
	"scripts": {
		"play": "next dev",
		"dev": "doppler run --command=\"PORT=3050 next dev\"",
		"build:dev": "doppler run --command=\"next build\"",
		"build": "next build",
		"start": "next start",
		"check": "ultracite check",
		"fix": "ultracite fix",
		"clean": "rm -rf node_modules pnpm-lock.yaml .next && pnpm install",
		"test": "vitest run",
		"test:ui": "vitest run --reporter=ui",
		"test:debug": "vitest run --debug",
		"test:watch": "vitest watch"
	},
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.12.4",
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.55",
		"@react-pdf/renderer": "^4.9.0",
		"@yudiel/react-qr-scanner": "^2.6.0",
		"ai": "^7.0.114",
		"bcrypt": "^6.0.0",
		"clsx": "^2.1.1",
		"mongoose": "^9.10.2",
		"next": "16.3.6",
		"next-auth": "^4.24.15",
		"react": "19.3.0",
		"react-intersection-observer": "^11.0.1",
		"react-toastify": "^11.1.0",
		"sass": "^1.105.0",
		"swr": "^2.5.1",
		"xtreme-ui": "^0.0.134"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@svgr/webpack": "^8.1.0",
		"@types/bcrypt": "^6.0.0",
		"@types/node": "26.6.2",
		"@types/react": "19.3.0",
		"typescript": "7.0.2",
		"ultracite": "7.12.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^5.1.0"
	}
}